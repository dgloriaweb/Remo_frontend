FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Vite uses `.env.production` automatically for `--mode production`.
RUN npm run build -- --mode production

EXPOSE 5175

CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "5175", "--strictPort"]

